# Token del bot de Telegram (de @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# API key de Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=tu-api-key-de-gemini
GEMINI_MODEL=gemini-3.5-flash

# Base de datos SQLite (se crea sola si no existe)
DB_PATH=gastos.db
INITIAL_BALANCE=0

# Categorías de gasto (separadas por coma, sin espacios extra)
EXPENSE_CATEGORIES=Supermercado,Salidas,Combustible,Mascotas,Regalos,Delivery,Servicios,Compras,Salud,Deporte,Otros

# IDs de Telegram autorizados a usar el bot, separados por coma.
# Dejar vacío = cualquiera puede usarlo (NO recomendado).
# Para obtener tu user_id, hablale a @userinfobot en Telegram.
ALLOWED_USER_IDS=

LOG_LEVEL=INFO
LOG_DIR=logs
