# Token del bot de Telegram (de @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# API key de Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=tu-api-key-de-gemini
GEMINI_MODEL=gemini-3.5-flash

# IAs de respaldo GRATIS (opcionales) por si Gemini agota su cuota (429).
# Se prueban en este orden y se saltan solas si están vacías. Solo cubren
# el flujo de texto (no imagen/audio). Sacar clave gratis en:
#   Groq:       https://console.groq.com/keys
#   OpenRouter: https://openrouter.ai/keys
#   Mistral:    https://console.mistral.ai/api-keys
#   Zhipu:      https://open.bigmodel.cn/usercenter/apikeys
#   xAI:        https://console.x.ai
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
ZHIPU_API_KEY=
XAI_API_KEY=

# Base de datos SQLite (se crea sola si no existe)
DB_PATH=gastos.db
INITIAL_BALANCE=0

# Categorías de gasto (separadas por coma, sin espacios extra)
EXPENSE_CATEGORIES=Supermercado,Salidas,Combustible,Mascotas,Regalos,Delivery,Servicios,Compras,Salud,Deporte,Otros

# IDs de Telegram autorizados a usar el bot, separados por coma.
# Registro ABIERTO por defecto (vacío): cualquiera que le escriba a Coco
# queda registrado solo, con su propio perfil aislado (ver USER_PROFILES).
# Para restringir el acceso, lista aquí los user_ids permitidos (obtenidos
# hablándole a @userinfobot en Telegram).
ALLOWED_USER_IDS=

# Perfiles: agrupa varias cuentas de Telegram bajo un mismo "perfil" para que
# compartan saldos/gastos/racha (ej. tus dos cuentas). Cada persona/grupo con
# datos AISLADOS entre sí. Formato: "nombre:id1|id2,otro_nombre:id3".
# Cualquier ID en ALLOWED_USER_IDS que NO aparezca aquí queda como su propio
# perfil aislado automáticamente (no hace falta listarlo).
# Ejemplo: USER_PROFILES=samuel:111111|222222,giovanna:333333
USER_PROFILES=

LOG_LEVEL=INFO
LOG_DIR=logs
